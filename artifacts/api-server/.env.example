# Supabase Postgres — use the TRANSACTION POOLER connection string (port 6543),
# not the direct connection (port 5432). Vercel serverless functions are
# short-lived, and the pooler is required to avoid exhausting Postgres
# connections. Find it in: Supabase Dashboard -> Project Settings -> Database
# -> Connection string -> "Transaction pooler".
DATABASE_URL=postgresql://postgres.kolraruporsdbhhcjeda:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Secret used to sign admin/staff JWTs (separate from customer auth, which
# uses Clerk). Generate a random 32+ byte value, e.g.:
#   openssl rand -base64 32
ADMIN_JWT_SECRET=

# Clerk (customer auth). From Clerk Dashboard -> API Keys.
# @clerk/express reads these from process.env automatically.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Existing AI/API keys (unchanged from before the migration)
GROQ_API_KEY=

LOG_LEVEL=info
NODE_ENV=production
