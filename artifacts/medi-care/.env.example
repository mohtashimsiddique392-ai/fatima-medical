# Clerk publishable key (safe to expose client-side). From Clerk Dashboard -> API Keys.
VITE_CLERK_PUBLISHABLE_KEY=

# Only needed for split local dev (frontend and API on different ports/hosts).
# Leave unset in production — the frontend calls same-origin "/api" by default
# since both are deployed together as one Vercel project.
# VITE_API_URL=http://localhost:8080/api
