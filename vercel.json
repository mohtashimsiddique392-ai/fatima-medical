{
  "buildCommand": "pnpm install --no-frozen-lockfile && pnpm --filter @workspace/medi-care run build",
  "outputDirectory": "artifacts/medi-care/dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
